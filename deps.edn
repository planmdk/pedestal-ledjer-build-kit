{:paths ["src"
         "resources"]
 :deps {org.clojure/clojure {:mvn/version "1.12.4"}
        dk.planm/ledjer {:git/url "https://github.com/planmdk/ledjer"
                         :git/sha "ab1c4bf1a1db7f5f9836d53cac583f1c45bfef30"
                         :deps/root "core"}
        io.pedestal/pedestal.jetty {:mvn/version "0.8.1"}
        io.github.escherize/huff {:mvn/version "0.2.21"}
        metosin/malli {:mvn/version "0.20.0"}
        aero/aero {:mvn/version "1.1.6"}
        party.donut/system {:mvn/version "1.0.258"}
        tick/tick {:mvn/version "1.0"}
        ch.qos.logback/logback-classic {:mvn/version "1.5.26"}
        thheller/shadow-cljs {:mvn/version "3.3.5"}
        com.thheller/shadow-graft {:mvn/version "0.9.0"}}
 :aliases
 {:outdated {:deps {com.github.liquidz/antq {:mvn/version "RELEASE"}}
             :main-opts ["-m" "antq.core"]}

  :nrepl {:extra-deps {cider/cider-nrepl {:mvn/version "0.55.7"}
                       nrepl/nrepl {:mvn/version "1.3.1"}
                       refactor-nrepl/refactor-nrepl {:mvn/version "3.11.0"}}
          :main-opts ["-m" "shadow.cljs.devtools.cli" "clj-repl"]}

  :test {:extra-paths ["test" "test-resources"]
         :jvm-opts ["-Dio.pedestal.dev-mode=true"]
         :extra-deps {org.clojure/test.check {:mvn/version "1.1.1"}
                      nubank/matcher-combinators {:mvn/version "3.9.1"}
                      io.github.cognitect-labs/test-runner {:git/tag "v0.5.1"
                                                            :git/sha "dfb30dd"}}
         :main-opts ["-m" "cognitect.test-runner"]
         :exec-fn cognitect.test-runner.api/test}

  :run {:exec-fn quickstart.main/start-service}}}
